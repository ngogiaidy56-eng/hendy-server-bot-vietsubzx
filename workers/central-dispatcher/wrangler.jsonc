{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"hendy-central-dispatcher",
  "main":"src/index.ts",
  "compatibility_date":"2026-10-01",
  "compatibility_flags":["nodejs_compat"],
  "d1_databases":[{"binding":"DB","database_name":"hendy_vietsub","database_id":"REPLACE_WITH_D1_ID","migrations_dir":"../../database/d1-migrations"}],
  "kv_namespaces":[{"binding":"CONFIG","id":"REPLACE_WITH_KV_ID"}],
  "r2_buckets":[{"binding":"ASSETS","bucket_name":"hendy-assets"}],
  "vars":{"ENVIRONMENT":"production"},
  "secrets_store_secrets":[]
}
